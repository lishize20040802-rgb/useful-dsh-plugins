{
  "name": "dsh-plugin-vision-reader",
  "version": "0.2.2",
  "description": "DeepSeek Harness host+client plugin: images go straight to the main model untouched, and pasted images are persisted to local files so the same picture can be re-read at any later point. Adds a `vision` tool for an independent second opinion from DeepSeek's built-in multimodal model (deepseek-v4-flash-vision-exp). No extra API key required.",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "plugin",
    "vision",
    "image",
    "multimodal",
    "read_image"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "18.3.31",
    "esbuild": "0.24.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lishize20040802-rgb/useful-dsh-plugins.git",
    "directory": "dsh-plugin-vision-reader"
  },
  "testedDSHVersions": [
    "0.1.5-rc.2"
  ]
}
