    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "plugin",
    "upload",
    "attachment",
    "pdf",
    "docx",
    "xlsx",
    "vision",
    "image",
    "multimodal",
    "desktop"
  ],
  "type": "module",
  "files": [
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lishize20040802-rgb/useful-dsh-plugins.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "dsh-upload-button": "^0.3.0",
    "dsh-plugin-doc-reader": "^0.1.2",
    "dsh-plugin-vision-reader": "^0.1.0",
    "dsh-desktop-config": "^0.1.0",
    "useful-dsh-plugin-manager": "^0.1.0"
  },
  "scripts": {
